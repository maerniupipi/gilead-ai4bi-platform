# Copy to a protected environment file; never commit real values.
BATCH_ADMIN_PASSWORD=replace-with-a-long-unique-password
BATCH_DATABASE_URL=sqlite:////data/batch.sqlite3
# Optional external database:
# BATCH_DATABASE_URL=postgresql+psycopg://batch_runner:REPLACE_ME@db.example.com:5432/batch_runner?sslmode=require
BATCH_ALLOWED_HOSTS=localhost,127.0.0.1
BATCH_COOKIE_SECURE=false
BATCH_ALLOW_LOCAL_PATHS=false
