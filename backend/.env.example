# 数据库配置
DATABASE_URL=mysql+mysqlconnector://root:password@localhost:3306/chatbi
# 主库连接池：并发不足时优先调 DB_POOL_SIZE / DB_MAX_OVERFLOW；等待超时后会快速返回 503，避免请求无限挂住
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
DB_READ_TIMEOUT_SECONDS=30
DB_WRITE_TIMEOUT_SECONDS=30
# 启动时是否执行 SQLAlchemy create_all 建表检查；生产库已有迁移时可设为 false
DB_CREATE_ALL_ON_STARTUP=true
# 外部业务数据源连接池和超时，避免慢数据源拖垮主库/API 进程
EXTERNAL_DB_POOL_SIZE=3
EXTERNAL_DB_MAX_OVERFLOW=2
EXTERNAL_DB_POOL_TIMEOUT_SECONDS=8
EXTERNAL_DB_CONNECT_TIMEOUT_SECONDS=10
EXTERNAL_DB_READ_TIMEOUT_SECONDS=30
EXTERNAL_DB_WRITE_TIMEOUT_SECONDS=30
# 审计日志 DB 写入限流；DB 压力大时可先设 AUDIT_LOG_DB_ENABLED=false 保留文件审计日志
AUDIT_LOG_DB_ENABLED=true
AUDIT_LOG_DB_MAX_WORKERS=4
AUDIT_LOG_DB_QUEUE_LIMIT=200
# 评测任务进度 SSE：每条连接按间隔短查询一次，不长期占用 DB session
EVAL_PROGRESS_SSE_INTERVAL_SECONDS=2
EVAL_PROGRESS_SSE_MAX_SECONDS=3600

# Milvus 向量数据库配置
MILVUS_HOST=your_milvus_host
MILVUS_PORT=19530
MILVUS_USER=root
MILVUS_PASSWORD=your_password
MILVUS_DB_NAME=app

# Elasticsearch 配置（以下两套等价，任选其一；代码会同时识别）
# ES_HOST=http://your-cluster:9200
# ES_USER=elastic
# ES_PASSWORD=secret
ES_URL=http://your_elasticsearch_host:9200
ES_USERNAME=your_es_user
ES_PASSWORD=your_es_password

# 阿里云 Embedding 模型配置
EMBEDDING_PROVIDER=aliyun
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=your_api_key
EMBEDDING_DIMENSION=1024

# Redis 配置（AutoBI 实验室流水线日志等；不配置 REDIS_HOST 时追踪接口使用进程内内存，仅单机调试用）
REDIS_HOST=your_redis_host
REDIS_PORT=6379
# 远端需要 ACL 时再填；REDIS_HOST 为 127.0.0.1 / localhost / ::1 时默认不传账号密码（本地无密码实例）
REDIS_USERNAME=
REDIS_PASSWORD=
# 本机 Redis 若也启用了密码，设为 1 以强制使用上面的 REDIS_USERNAME / REDIS_PASSWORD
# REDIS_USE_AUTH_ON_LOCAL=1
# 实验室追踪记录在 Redis 中的 TTL（秒），0 表示不过期，默认 7 天
# AUTOB_LAB_TRACE_TTL_SECONDS=604800

# 智能体工作流：画布撤销栈 / 单次运行 trace 在 Redis 中的 TTL（秒）；不设 REDIS_HOST 时仍可用进程内内存
# AGENT_WORKFLOW_HISTORY_TTL_SECONDS=3600
# AGENT_RUN_TRACE_TTL_SECONDS=604800

# 密码加密密钥（32字节 hex，勿泄露到版本控制）
# 生成: python3 -c "import os; print(os.urandom(32).hex())"
PASSWORD_ENCRYPTION_KEY=your_64_char_hex_key

# FastAPI配置
HOST=0.0.0.0
PORT=8000
RELOAD=true
# 生产环境建议 RELOAD=false，并按机器规格设置 workers；每个 worker 都会创建一组 DB 连接池
UVICORN_WORKERS=1

# MCP：与后端同机同端口，仅路径不同。SSE 入口示例（供 Cursor / MCP Inspector）：
# http://127.0.0.1:8000/api/mcp/sse

# 应用日志（app.* 的 logger.info）；默认 INFO，调试可设 DEBUG
# LOG_LEVEL=INFO

# ===== XLSX 表格智能问答工具 =====
# 阿里云 OSS：模块上传的 xlsx 原文件存这里；下载走签名 URL
XLSX_QA_OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
XLSX_QA_OSS_BUCKET=your_bucket
XLSX_QA_OSS_ACCESS_KEY_ID=your_access_key_id
XLSX_QA_OSS_ACCESS_KEY_SECRET=your_access_key_secret
# 所有对象统一前缀，便于分桶 / 清理
XLSX_QA_OSS_PREFIX=xlsx-qa/
# 下载预签名 URL 过期时间（秒），默认 15 分钟
XLSX_QA_OSS_DOWNLOAD_EXPIRES=900
# 单文件上限 / 行数上限 / 列数上限（超限直接拒绝）
XLSX_QA_MAX_FILE_BYTES=52428800
XLSX_QA_MAX_ROWS=100000
XLSX_QA_MAX_COLUMNS=200
# SQL 执行硬上限：单条返回行数 / 毫秒级超时
XLSX_QA_SQL_MAX_ROWS=1000
XLSX_QA_SQL_TIMEOUT_MS=10000

# 可选：分享页所在站点 origin（无路径、无尾斜杠），issue 接口带回前端拼 http(s)://host:3840/share.html#/token
# XLSX_QA_SHARE_PUBLIC_BASE_URL=http://localhost:3840


# 通用同步任务；默认不创建任务。详细配置见 docs/data-sync.md。
DATA_SYNC_TASKS={}
DATA_SYNC_DATABASE_URL=
DATA_SYNC_TMP_DIR=data/sync

# 初始化脚本必须显式提供管理员密码
INIT_SUPER_ADMIN_USERNAME=admin
INIT_SUPER_ADMIN_PASSWORD=
# 通用服务（Key 可在管理中心创建，不必配置环境引导 Key）
CHATBI_ENV=uat
CHATBI_API_ENABLED=true
CHATBI_API_KEY=
CHATBI_AUTOBI_PROJECT_ID=
CHATBI_AGENT_APP_ID=
CHATBI_AGENT_VERSION_ID=
CHATBI_PUBLIC_BASE_URL=http://localhost:8000
CHATBI_STORAGE_DIR=data/exports
CHATBI_EXPORT_WORKER_ENABLED=false
CHATBI_EXPORT_REQUEST_WORKER_ENABLED=false
CHATBI_DOWNLOAD_SIGNING_KEY=

# 执行容量与隔离（各 API / 后台进程独立计算容量）
PLATFORM_DB_WORKERS=8
PLATFORM_RETRIEVAL_WORKERS=16
PLATFORM_EXECUTION_CONCURRENCY=32
PLATFORM_EXECUTION_TIMEOUT_SECONDS=1800
PLATFORM_WORKER_DB_POOL_SIZE=5
WORKFLOW_SCRIPT_CONCURRENCY=4
WORKFLOW_SCRIPT_QUEUE_CAPACITY=64
WORKFLOW_SCRIPT_TIMEOUT_SECONDS=120
# 本地直接运行 uvicorn 时默认为 inline；容器的 app.runtime 自动使用独立后台进程。
# PLATFORM_BACKGROUND_MODE=inline
