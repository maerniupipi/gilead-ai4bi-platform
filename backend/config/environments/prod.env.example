# =============================================================================
# 生产环境 — 复制为 prod.env 并填写（prod.env 不入库）
#   cp config/environments/prod.env.example config/environments/prod.env
#
# APP_ENV=prod 时自动加载。生产亦可通过 CI/K8s 注入环境变量而不使用文件。
# 可选设置 DOTENV_PATH=/run/secrets/app.env 指向挂载的密钥文件。
# =============================================================================

APP_ENV=prod

# --- MySQL ---
DATABASE_URL=mysql+mysqlconnector://user:password@your-prod-host:3306/your_db

# --- 首次初始化脚本 scripts/init_database.py 使用 ---
# INIT_SUPER_ADMIN_USERNAME=admin
# INIT_SUPER_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
# INIT_SUPER_ADMIN_DISPLAY_NAME=超级管理员
# INIT_SPACE_NAME=默认空间
# INIT_SPACE_CODE=default
# INIT_SPACE_DESCRIPTION=系统默认空间

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# --- 建议生产启用加密密钥 ---
# PASSWORD_ENCRYPTION_KEY=

# --- Uvicorn（生产通常 RELOAD=false，由进程管理器启动多 worker）---
HOST=0.0.0.0
PORT=8000
RELOAD=false
UVICORN_WORKERS=2

# --- CORS（逗号分隔；不要在生产使用 *）---
CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOW_CREDENTIALS=true

# --- 部署版本（建议由 CI/CD 注入，例如 v2026.05.09-001）---
APP_VERSION=
