# =============================================================================
# UAT — 复制为 uat.env 并填写（uat.env 不入库）
#   cp config/environments/uat.env.example config/environments/uat.env
#
# APP_ENV=uat 时自动加载。其余云服务密钥以「项目管理」为准。
# =============================================================================

APP_ENV=uat

# --- MySQL ---
DATABASE_URL=mysql+mysqlconnector://user:password@your-uat-host:3306/your_uat_db

# --- 首次初始化脚本 scripts/init_database.py 使用 ---
# INIT_SUPER_ADMIN_USERNAME=admin
# INIT_SUPER_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
# INIT_SUPER_ADMIN_DISPLAY_NAME=超级管理员
# INIT_SPACE_NAME=默认空间
# INIT_SPACE_CODE=default
# INIT_SPACE_DESCRIPTION=系统默认空间

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# --- 可选 ---
# PASSWORD_ENCRYPTION_KEY=

# --- Uvicorn ---
HOST=0.0.0.0
PORT=8000
RELOAD=false
UVICORN_WORKERS=2

# --- CORS（逗号分隔；示例: https://uat.example.com,http://localhost:3000）---
CORS_ALLOWED_ORIGINS=https://uat.example.com
CORS_ALLOW_CREDENTIALS=true
