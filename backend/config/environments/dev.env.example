# =============================================================================
# 开发环境 — 复制为 dev.env 并填写（dev.env 不入库）
#   cp config/environments/dev.env.example config/environments/dev.env
# =============================================================================

APP_ENV=dev

# --- MySQL ---
DATABASE_URL=mysql+mysqlconnector://root:password@localhost:3306/chatbi

# --- 首次初始化脚本 scripts/init_database.py 使用 ---
# INIT_SUPER_ADMIN_USERNAME=admin
# INIT_SUPER_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
# INIT_SUPER_ADMIN_DISPLAY_NAME=超级管理员
# INIT_SPACE_NAME=默认空间
# INIT_SPACE_CODE=default
# INIT_SPACE_DESCRIPTION=系统默认空间

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# --- 本地运行 ---
HOST=0.0.0.0
PORT=8000
RELOAD=true
UVICORN_WORKERS=1

# --- 本地调试可放开跨域；生产请写明确域名 ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

# --- 密码加密密钥（32 字节 hex；不要提交真实值）---
# PASSWORD_ENCRYPTION_KEY=
