# Merge into the deployment's secret configuration; never put a real Key in Git.
# APP_ENV=uat or prod must agree with CHATBI_ENV. Local APP_ENV=dev can use uat.
CHATBI_ENV=uat
CHATBI_API_KEY=app-uat-REPLACE_WITH_GENERATED_256_BIT_KEY
CHATBI_API_ENABLED=true
# Choose an analysis project from this environment's database. Do not copy IDs across environments.
CHATBI_AUTOBI_PROJECT_ID=
# Optional: override only named AutoBI model bindings for this deployment.
CHATBI_MODEL_BINDINGS={}
# Or: CHATBI_AGENT_APP_ID / CHATBI_AGENT_VERSION_ID
CHATBI_PUBLIC_BASE_URL=https://REPLACE_WITH_THIS_ENVIRONMENT_HOST
CHATBI_STORAGE_DIR=/data/chatbi-exports
# Enable only on the deployment serving this storage; keep false/unset locally.
CHATBI_EXPORT_WORKER_ENABLED=true
# Optional local mode: process only exports accepted by this server, without polling a shared queue.
CHATBI_EXPORT_REQUEST_WORKER_ENABLED=false
CHATBI_DOWNLOAD_SIGNING_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
# Legacy fallback only. Prefer Management -> Multimodal -> AI PPT model settings.
CHATBI_SUMMARY_PROVIDER_ID=
CHATBI_SUMMARY_MODEL=
